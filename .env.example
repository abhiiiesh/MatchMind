# ============================================================
# MatchMind Environment Configuration
# ============================================================

# App Settings
MATCHMIND_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_GPT4O_DEPLOYMENT=gpt-4o
AZURE_OPENAI_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini

# Azure Cosmos DB (NoSQL State & Vector Store)
AZURE_COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
AZURE_COSMOS_KEY=your_cosmos_key_here
AZURE_COSMOS_DATABASE=matchmind

# Azure AI Speech (Text-to-Speech Commentary)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Azure AI Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com/

# Synthetic Data & Streaming
STREAM_INTERVAL_SECONDS=1.0
DATA_CACHE_DIR=./data/cache
